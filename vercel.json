{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "data/*.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/data/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/",
      "destination": "/web_app/index.html"
    },
    {
      "source": "/web_app/(.*)",
      "destination": "/web_app/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/web_app/$1"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, must-revalidate" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
