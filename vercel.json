{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "data/{pg_home_live_state,app_state,all_groups_monitor_state,zalo_staging_inbox,zalo_live_attendance,multi_group_telemetry,zalo_verified_entities,zalo_filenoise_index,zalo_leveldb_intel,zalo_v6_master_summary,zalo_health_report,THONG_TIN_DANG_KY_KINH_DOANH_PHU_GIA}.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/data/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/",
      "destination": "/web_app/index.html"
    },
    {
      "source": "/web_app/(.*)",
      "destination": "/web_app/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/web_app/$1"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|png|svg|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
